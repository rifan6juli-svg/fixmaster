# Database. Local: Supabase local (pnpm db:start).
# Production: Supabase shared pooler, transaction mode (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Production only, used to run migrations: direct connection (port 5432, IPv6)
# or shared pooler, session mode (port 5432). Empty: migrations use DATABASE_URL.
DIRECT_URL=

# Random string, at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Base URL for customer status links: {APP_URL}/s/{token}
APP_URL=http://localhost:3000

# 32 random bytes, base64-encoded (openssl rand -base64 32).
# Losing this key makes stored device lock secrets unreadable.
DEVICE_SECRET_KEY=
