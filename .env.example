# Database. "file:" uses PGlite (local); "postgres://" uses postgres-js
# (Supabase transaction pooler, port 6543).
DATABASE_URL=file:./.data/pglite

# Production only: direct connection (port 5432) used to run migrations.
DIRECT_URL=

# Random string, at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Base URL for customer status links: {APP_URL}/s/{token}
APP_URL=http://localhost:3000

# 32 random bytes, base64-encoded (openssl rand -base64 32).
# Losing this key makes stored device lock secrets unreadable.
DEVICE_SECRET_KEY=
